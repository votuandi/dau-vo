generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AthleteColor {
  RED
  BLUE

  @@map("athlete_color")
}

enum TournamentStatus {
  DRAFT
  ACTIVE
  FINISHED
  ARCHIVED

  @@map("tournament_status")
}

enum TournamentDeletionReason {
  ADMIN_SUBSCRIPTION_LAPSED

  @@map("tournament_deletion_reason")
}

enum MatchStatus {
  WAITING
  ROUND_1_RUNNING
  ROUND_1_PAUSED
  BREAK
  ROUND_2_RUNNING
  ROUND_2_PAUSED
  AWAITING_RESULT_SAVE
  REGULATION_APPEAL
  OVERTIME_READY
  OVERTIME_RUNNING
  OVERTIME_PAUSED
  OVERTIME_APPEAL
  OVERTIME_TIEBREAK_DECISION
  RESULT_PUBLICATION_READY
  FINISHED

  @@map("match_status")
}

enum RoundStage {
  REGULATION
  OVERTIME

  @@map("round_stage")
}

enum MatchRulesVersion {
  LEGACY_SCORE_PENALTY_V1
  FAULT_APPEAL_OVERTIME_V2

  @@map("match_rules_version")
}

enum MatchAppealScope {
  REGULATION
  OVERTIME

  @@map("match_appeal_scope")
}

enum MatchAppealStatus {
  COMPLETED
  INVALIDATED

  @@map("match_appeal_status")
}

enum MatchOutcomeMethod {
  REGULATION_SCORE
  OVERTIME_SCORE
  MANUAL_AFTER_OVERTIME_TIE

  @@map("match_outcome_method")
}

enum MatchLifecycle {
  NOT_STARTED
  IN_PROGRESS
  SUSPENDED
  COMPLETED

  @@map("match_lifecycle")
}

enum MatchRole {
  REFEREE
  INSPECTOR

  @@map("match_role")
}

enum TournamentOfficialRole {
  REFEREE
  INSPECTOR

  @@map("tournament_official_role")
}

enum MatchOfficialAssignmentReleaseReason {
  MATCH_FINISHED
  OPERATIONAL_CANCELLED
  MATCH_EXIT_CANCELLED
  MATCH_EXIT_SUSPENDED_KEEP_ROUND_1
  MATCH_EXIT_SUSPENDED_KEEP_ROUNDS_1_AND_2
  RESET_REQUIRES_SETUP
  INSPECTOR_RELEASED
  REPLACED
  OFFICIAL_DEACTIVATED

  @@map("match_official_assignment_release_reason")
}

enum RefereeSlot {
  REFEREE_1
  REFEREE_2
  REFEREE_3

  @@map("referee_slot")
}

enum MatchAccessRole {
  REFEREE_1
  REFEREE_2
  REFEREE_3
  INSPECTOR

  @@map("match_access_role")
}

enum ScoreEventType {
  REFEREE_POINT
  PENALTY
  ADMIN_ADJUSTMENT

  @@map("score_event_type")
}

enum MatchResultOperationType {
  ROUND_RESET
  MATCH_RESET
  MATCH_EXIT_CANCEL_RESULTS
  MATCH_EXIT_SUSPEND_KEEP_ROUND_1
  MATCH_EXIT_SUSPEND_KEEP_ROUNDS_1_AND_2

  @@map("match_result_operation_type")
}

enum MatchResultOperationStatus {
  APPLIED
  UNDONE

  @@map("match_result_operation_status")
}

enum AuditEventType {
  ADMIN_ACTION
  MATCH_ACTION
  SESSION_ACTION
  SCORE_ACTION
  PENALTY_ACTION
  SYSTEM_EVENT
  TOURNAMENT_CREATED
  TOURNAMENT_UPDATED
  MATCH_CREATED
  MATCH_UPDATED
  MATCH_CODE_REGENERATED
  ROUND_STARTED
  ROUND_PAUSED
  ROUND_RESUMED
  ROUND_RESULT_CANCELLED
  ROUND_RESULT_CANCEL_UNDONE
  MATCH_RESULT_RESET
  MATCH_RESULT_RESET_UNDONE
  MATCH_EXITED
  ROUND_ENDED
  MATCH_FINISHED
  PRICING_VERSION_CREATED
  BRACKET_CONFIRMED
  BRACKET_MATCH_PREPARED
  BRACKET_WINNER_ADVANCED
  BRACKET_WINNER_MANUALLY_DECIDED
  BRACKET_WINNER_RETRACTED
  BRACKET_COMPLETED
  BRACKET_CANCELLED
  TOURNAMENT_OFFICIAL_CREATED
  TOURNAMENT_OFFICIAL_UPDATED
  TOURNAMENT_OFFICIAL_DEACTIVATED
  TOURNAMENT_OFFICIAL_PASSCODE_REGENERATED
  MATCH_INSPECTOR_CLAIMED
  MATCH_OFFICIAL_ASSIGNMENT_CONFIRMED
  MATCH_OFFICIAL_ASSIGNMENT_REPLACED
  MATCH_OFFICIAL_ASSIGNMENT_RELEASED
  BRACKET_ROUND_STAFFING_UPDATED

  @@map("audit_event_type")
}

enum BracketStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("bracket_status")
}

enum BracketFixtureStatus {
  PENDING_PARTICIPANTS
  READY
  MATCH_PREPARED
  AWAITING_WINNER
  COMPLETED

  @@map("bracket_fixture_status")
}

enum PricingDiscountType {
  DURATION
  TOURNAMENT

  @@map("pricing_discount_type")
}

enum AdminEntitlementStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED

  @@map("admin_entitlement_status")
}

enum SubscriptionPaymentStatus {
  SIMULATED_SUCCESS

  @@map("subscription_payment_status")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER

  @@map("user_role")
}

model User {
  id                         String               @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName                   String?              @map("full_name") @db.VarChar(255)
  username                   String               @db.VarChar(100)
  normalizedUsername         String               @unique(map: "users_normalized_username_key") @map("normalized_username") @db.VarChar(100)
  email                      String?              @db.VarChar(320)
  normalizedEmail            String?              @unique(map: "users_normalized_email_key") @map("normalized_email") @db.VarChar(320)
  phone                      String?              @db.VarChar(50)
  normalizedPhone            String?              @unique(map: "users_normalized_phone_key") @map("normalized_phone") @db.VarChar(50)
  organization               String?              @db.VarChar(255)
  passwordHash               String               @map("password_hash") @db.VarChar(255)
  role                       UserRole             @default(USER)
  isActive                   Boolean              @default(true) @map("is_active")
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime?            @map("deleted_at") @db.Timestamptz(3)
  auditLogs                  AuditLog[]
  ownedTournaments           Tournament[]         @relation("TournamentOwner")
  createdPricingPlanVersions PricingPlanVersion[] @relation("PricingPlanVersionCreator")
  adminEntitlement           AdminEntitlement?
  subscriptionOrders         SubscriptionOrder[]
  confirmedBrackets          TournamentBracket[]  @relation("TournamentBracketConfirmedBy")

  @@map("users")
}

model Tournament {
  id             String                    @id(map: "tournaments_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicCode     String                    @unique(map: "tournaments_public_code_key") @map("public_code") @db.VarChar(32)
  name           String                    @db.VarChar(255)
  description    String?                   @db.Text
  imagePath      String?                   @map("image_path") @db.VarChar(1024)
  location       String?                   @db.VarChar(255)
  startDate      DateTime?                 @map("start_date") @db.Date
  endDate        DateTime?                 @map("end_date") @db.Date
  status         TournamentStatus          @default(DRAFT)
  ownerUserId    String                    @map("owner_user_id") @db.Uuid
  sportId        String                    @map("sport_id") @db.Uuid
  softDeletedAt  DateTime?                 @map("soft_deleted_at") @db.Timestamptz(3)
  purgeAfter     DateTime?                 @map("purge_after") @db.Timestamptz(3)
  deletionReason TournamentDeletionReason? @map("deletion_reason")
  restoredAt     DateTime?                 @map("restored_at") @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  matches        Match[]
  organizations  TournamentOrganization[]
  weightClasses  TournamentWeightClass[]
  athletes       TournamentAthlete[]
  brackets       TournamentBracket[]
  officials      TournamentOfficial[]
  owner          User                      @relation("TournamentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "tournaments_owner_user_id_fkey")
  sport          Sport                     @relation(fields: [sportId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "tournaments_sport_id_fkey")

  @@index([ownerUserId, status], map: "tournaments_owner_user_id_status_idx")
  @@index([ownerUserId, createdAt], map: "tournaments_owner_user_id_created_at_idx")
  @@index([ownerUserId, softDeletedAt], map: "tournaments_owner_soft_deleted_at_idx")
  @@index([purgeAfter], map: "tournaments_purge_after_idx")
  @@index([sportId], map: "tournaments_sport_id_idx")
  @@map("tournaments")
}

// Durable outbox for storage cleanup. Rows are written in the same transaction
// that makes an image unreachable, then deleted only after an idempotent storage
// delete succeeds. This keeps object I/O outside database transactions.
model MediaDeletion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey  String    @unique(map: "media_deletions_storage_key_key") @map("storage_key") @db.VarChar(1024)
  reason      String    @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text
  lastTriedAt DateTime? @map("last_tried_at") @db.Timestamptz(3)

  @@index([createdAt], map: "media_deletions_created_at_idx")
  @@map("media_deletions")
}

model SportGroup {
  id        String   @id(map: "sport_groups_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique(map: "sport_groups_code_key") @db.VarChar(100)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sports    Sport[]

  @@map("sport_groups")
}

model Sport {
  id             String       @id(map: "sports_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String       @unique(map: "sports_code_key") @db.VarChar(100)
  name           String       @db.VarChar(255)
  normalizedName String       @unique(map: "sports_normalized_name_key") @map("normalized_name") @db.VarChar(255)
  sportGroupId   String       @map("sport_group_id") @db.Uuid
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sportGroup     SportGroup   @relation(fields: [sportGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "sports_sport_group_id_fkey")
  tournaments    Tournament[]

  @@index([sportGroupId], map: "sports_sport_group_id_idx")
  @@map("sports")
}

model AdminEntitlement {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String                 @unique @map("user_id") @db.Uuid
  status                   AdminEntitlementStatus @default(ACTIVE)
  activeFrom               DateTime               @map("active_from") @db.Timestamptz(3)
  activeUntil              DateTime               @map("active_until") @db.Timestamptz(3)
  tournamentLimit          Int                    @map("tournament_limit")
  adminAccessEndedAt       DateTime?              @map("admin_access_ended_at") @db.Timestamptz(3)
  manualAdjustmentMetadata Json?                  @map("manual_adjustment_metadata") @db.JsonB
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "admin_entitlements_user_id_fkey")

  @@index([status, activeUntil], map: "admin_entitlements_status_active_until_idx")
  @@index([adminAccessEndedAt], map: "admin_entitlements_admin_access_ended_at_idx")
  @@map("admin_entitlements")
}

model SubscriptionOrder {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                    @map("user_id") @db.Uuid
  pricingPlanVersionId   String                    @map("pricing_plan_version_id") @db.Uuid
  idempotencyKey         String                    @unique @map("idempotency_key") @db.VarChar(255)
  durationBundle         Int                       @default(0) @map("duration_bundle")
  tournamentBundle       Int                       @default(0) @map("tournament_bundle")
  durationMonthsGranted  Int                       @map("duration_months_granted")
  tournamentLimitGranted Int                       @map("tournament_limit_granted")
  priceSnapshot          Json                      @map("price_snapshot") @db.JsonB
  totalAmountVnd         Int                       @map("total_amount_vnd")
  paymentStatus          SubscriptionPaymentStatus @default(SIMULATED_SUCCESS) @map("payment_status")
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  pricingPlanVersion     PricingPlanVersion        @relation(fields: [pricingPlanVersionId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("subscription_orders")
}

model PricingPlanVersion {
  id                           String                @id(map: "pricing_plan_versions_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baseAmountVnd                Int                   @map("base_amount_vnd")
  baseDurationMonths           Int                   @map("base_duration_months")
  baseTournamentLimit          Int                   @map("base_tournament_limit")
  durationAddonUnitAmountVnd   Int                   @map("duration_addon_unit_amount_vnd")
  tournamentAddonUnitAmountVnd Int                   @map("tournament_addon_unit_amount_vnd")
  active                       Boolean               @default(false)
  activatedAt                  DateTime?             @map("activated_at") @db.Timestamptz(3)
  createdByUserId              String?               @map("created_by_user_id") @db.Uuid
  createdAt                    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  discountTiers                PricingDiscountTier[]
  createdBy                    User?                 @relation("PricingPlanVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subscriptionOrders           SubscriptionOrder[]

  @@index([active], map: "pricing_plan_versions_active_idx")
  @@map("pricing_plan_versions")
}

model PricingDiscountTier {
  id                   String              @id(map: "pricing_discount_tiers_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pricingPlanVersionId String              @map("pricing_plan_version_id") @db.Uuid
  type                 PricingDiscountType
  quantity             Int
  discountBasisPoints  Int                 @map("discount_basis_points")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  pricingPlanVersion   PricingPlanVersion  @relation(fields: [pricingPlanVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([pricingPlanVersionId, type, quantity], map: "pricing_discount_tiers_version_type_quantity_key")
  @@map("pricing_discount_tiers")
}

// Names are unique for a tournament for the lifetime of a roster row.  A
// deactivated row can be reactivated, but must be renamed before a replacement
// with the same normalized name can be registered.
model TournamentOrganization {
  id             String              @id(map: "tournament_organizations_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId   String              @map("tournament_id") @db.Uuid
  name           String              @db.VarChar(255)
  normalizedName String              @map("normalized_name") @db.VarChar(255)
  location       String?             @db.VarChar(255)
  details        String?             @db.Text
  imagePath      String?             @map("image_path") @db.VarChar(1024)
  isActive       Boolean             @default(true) @map("is_active")
  deactivatedAt  DateTime?           @map("deactivated_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tournament     Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  athletes       TournamentAthlete[]

  @@unique([tournamentId, id], map: "tournament_organizations_tournament_id_id_key")
  @@unique([tournamentId, normalizedName], map: "tournament_organizations_tournament_id_normalized_name_key")
  @@index([tournamentId, isActive, normalizedName], map: "tournament_organizations_active_name_idx")
  @@map("tournament_organizations")
}

model TournamentWeightClass {
  id             String              @id(map: "tournament_weight_classes_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId   String              @map("tournament_id") @db.Uuid
  name           String              @db.VarChar(255)
  normalizedName String              @map("normalized_name") @db.VarChar(255)
  details        String?             @db.Text
  isActive       Boolean             @default(true) @map("is_active")
  deactivatedAt  DateTime?           @map("deactivated_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tournament     Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  athletes       TournamentAthlete[]
  matches        Match[]
  brackets       TournamentBracket[]

  @@unique([tournamentId, id], map: "tournament_weight_classes_tournament_id_id_key")
  @@unique([tournamentId, normalizedName], map: "tournament_weight_classes_tournament_id_normalized_name_key")
  @@index([tournamentId, isActive, normalizedName], map: "tournament_weight_classes_active_name_idx")
  @@map("tournament_weight_classes")
}

model TournamentAthlete {
  id              String                  @id(map: "tournament_athletes_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId    String                  @map("tournament_id") @db.Uuid
  organizationId  String?                 @map("organization_id") @db.Uuid
  weightClassId   String                  @map("weight_class_id") @db.Uuid
  name            String                  @db.VarChar(255)
  birthYear       Int                     @map("birth_year") @db.SmallInt
  details         String?                 @db.Text
  imagePath       String?                 @map("image_path") @db.VarChar(1024)
  isActive        Boolean                 @default(true) @map("is_active")
  deactivatedAt   DateTime?               @map("deactivated_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tournament      Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization    TournamentOrganization? @relation(fields: [tournamentId, organizationId], references: [tournamentId, id], onDelete: Restrict, onUpdate: Cascade)
  weightClass     TournamentWeightClass   @relation(fields: [tournamentId, weightClassId], references: [tournamentId, id], onDelete: Restrict, onUpdate: Cascade)
  matchAthletes   MatchAthlete[]
  bracketEntrants BracketEntrant[]

  @@unique([tournamentId, id], map: "tournament_athletes_tournament_id_id_key")
  @@index([tournamentId, isActive, name], map: "tournament_athletes_tournament_id_is_active_name_idx")
  @@index([tournamentId, organizationId, isActive], map: "tournament_athletes_tournament_id_organization_id_is_active_idx")
  @@index([tournamentId, weightClassId, isActive], map: "tournament_athletes_tournament_id_weight_class_id_is_active_idx")
  @@map("tournament_athletes")
}

model Match {
  id                   String                 @id(map: "matches_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId             String                 @unique(map: "matches_public_id_key") @map("public_id") @db.VarChar(32)
  tournamentId         String                 @map("tournament_id") @db.Uuid
  weightClassId        String?                @map("weight_class_id") @db.Uuid
  bracketFixtureId     String?                @unique(map: "matches_bracket_fixture_id_key") @map("bracket_fixture_id") @db.Uuid
  requiredRefereeCount Int                    @default(3) @map("required_referee_count") @db.SmallInt
  status               MatchStatus            @default(WAITING)
  lifecycle            MatchLifecycle         @default(NOT_STARTED)
  rulesVersion         MatchRulesVersion      @default(FAULT_APPEAL_OVERTIME_V2) @map("rules_version")
  suspendedAt          DateTime?               @map("suspended_at") @db.Timestamptz(3)
  currentRound         Int?                   @map("current_round") @db.SmallInt
  roundDurationMs      Int                    @map("round_duration_ms")
  breakDurationMs      Int                    @map("break_duration_ms")
  startedAt            DateTime?              @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime?              @map("finished_at") @db.Timestamptz(3)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tournament           Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "matches_tournament_id_fkey")
  weightClass          TournamentWeightClass? @relation(fields: [tournamentId, weightClassId], references: [tournamentId, id], onDelete: Restrict, onUpdate: Cascade, map: "matches_tournament_weight_class_id_fkey")
  athletes             MatchAthlete[]         @relation("MatchAthletesByMatchId")
  athletesByTournament MatchAthlete[]         @relation("MatchAthletesByTournament")
  accessCodes          MatchAccessCode[]
  sessions             MatchSession[]
  rounds               Round[]
  resultOperations     MatchResultOperation[]
  scoringWindows       ScoringWindow[]
  refereeVotes         RefereeVote[]
  scoreEvents          ScoreEvent[]
  penalties            Penalty[]
  faults               Fault[]
  roundAthleteResults  RoundAthleteResult[]
  appeals              MatchAppeal[]
  outcome              MatchOutcome?
  auditLogs            AuditLog[]
  officialAssignments  MatchOfficialAssignment[]
  bracketFixture       BracketFixture?        @relation("BracketFixtureMatch", fields: [bracketFixtureId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "matches_bracket_fixture_id_fkey")

  @@unique([id, tournamentId], map: "matches_id_tournament_id_key")
  @@index([tournamentId], map: "matches_tournament_id_idx")
  @@index([tournamentId, weightClassId], map: "matches_tournament_id_weight_class_id_idx")
  @@index([status], map: "matches_status_idx")
  @@index([lifecycle], map: "matches_lifecycle_idx")
  @@map("matches")
}

// Confirmed bracket aggregate. Preview data is intentionally never represented here.
model TournamentBracket {
  id                      String                @id(map: "tournament_brackets_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId            String                @map("tournament_id") @db.Uuid
  weightClassId           String                @map("weight_class_id") @db.Uuid
  status                  BracketStatus         @default(ACTIVE)
  athleteCount            Int                   @map("athlete_count")
  bracketSize             Int                   @map("bracket_size")
  roundCount              Int                   @map("round_count")
  confirmationKey         String                @unique(map: "tournament_brackets_confirmation_key_key") @map("confirmation_key") @db.VarChar(255)
  confirmationFingerprint String                @default("") @map("confirmation_fingerprint") @db.Char(64)
  confirmedByUserId       String?               @map("confirmed_by_user_id") @db.Uuid
  confirmedAt             DateTime              @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  completedAt             DateTime?             @map("completed_at") @db.Timestamptz(3)
  cancelledAt             DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  championEntrantId       String?               @map("champion_entrant_id") @db.Uuid
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tournament              Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "tournament_brackets_tournament_id_fkey")

  session              MatchSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "referee_votes_session_id_fkey")
  assignment           MatchOfficialAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "referee_votes_assignment_id_fkey")

  @@index([scoringWindowId], map: "referee_votes_scoring_window_id_idx")
  @@index([matchId], map: "referee_votes_match_id_idx")
  @@index([sessionId], map: "referee_votes_session_id_idx")
  @@index([assignmentId], map: "referee_votes_assignment_id_idx")
  @@map("referee_votes")
}

model ScoreEvent {
  id                String         @id(map: "score_events_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId           String         @map("match_id") @db.Uuid
  athleteId         String         @map("athlete_id") @db.Uuid
  roundNumber       Int?           @map("round_number") @db.SmallInt
  roundId           String?        @map("round_id") @db.Uuid
  occurredAt        DateTime?      @map("occurred_at") @db.Timestamptz(3)
  roundElapsedMs    Int?           @map("round_elapsed_ms")
  type              ScoreEventType
  value             Int
  scoringWindowId   String?        @map("scoring_window_id") @db.Uuid
  penaltyId         String?        @map("penalty_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  revertedAt        DateTime?      @map("reverted_at") @db.Timestamptz(3)
  revertedByAuditId String?        @map("reverted_by_audit_id") @db.Uuid
  match             Match          @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "score_events_match_id_fkey")
  round             Round?         @relation(fields: [roundId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "score_events_round_id_fkey")
  athlete           MatchAthlete   @relation(fields: [athleteId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "score_events_athlete_id_fkey")
  scoringWindow     ScoringWindow? @relation(fields: [scoringWindowId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "score_events_scoring_window_id_fkey")
  penalty           Penalty?       @relation(fields: [penaltyId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "score_events_penalty_id_fkey")

  @@index([matchId], map: "score_events_match_id_idx")
  @@index([athleteId], map: "score_events_athlete_id_idx")
  @@index([scoringWindowId], map: "score_events_scoring_window_id_idx")
  @@index([penaltyId], map: "score_events_penalty_id_idx")
  @@index([roundId], map: "score_events_round_id_idx")
  @@map("score_events")
}

model Penalty {
  id                 String       @id(map: "penalties_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId            String       @map("match_id") @db.Uuid
  athleteId          String       @map("athlete_id") @db.Uuid
  roundNumber        Int?         @map("round_number") @db.SmallInt
  value              Int          @default(-1)
  createdBySessionId String?      @map("created_by_session_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  revertedAt         DateTime?    @map("reverted_at") @db.Timestamptz(3)
  revertedByAuditId  String?      @map("reverted_by_audit_id") @db.Uuid
  match              Match        @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "penalties_match_id_fkey")
  athlete            MatchAthlete @relation(fields: [athleteId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "penalties_athlete_id_fkey")
  createdBySession   MatchSession? @relation("PenaltyCreatedBySession", fields: [createdBySessionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "penalties_created_by_session_id_fkey")
  scoreEvents        ScoreEvent[]

  @@index([matchId], map: "penalties_match_id_idx")
  @@index([athleteId], map: "penalties_athlete_id_idx")
  @@index([createdBySessionId], map: "penalties_created_by_session_id_idx")
  @@map("penalties")
}

// Canonical V2 faults are deliberately independent from ScoreEvent and legacy
// Penalty. A fault changes the Lỗi projection only; it cannot deduct points.
model Fault {
  id                            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId                       String                    @map("match_id") @db.Uuid
  athleteId                     String                    @map("athlete_id") @db.Uuid
  roundId                       String                    @map("round_id") @db.Uuid
  recordingInspectorAssignmentId String?                  @map("recording_inspector_assignment_id") @db.Uuid
  recordingInspectorSessionId   String?                    @map("recording_inspector_session_id") @db.Uuid
  createdAt                     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  invalidatedAt                 DateTime?                  @map("invalidated_at") @db.Timestamptz(3)
  invalidatedByAuditId          String?                    @map("invalidated_by_audit_id") @db.Uuid
  match                         Match                      @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  athlete                       MatchAthlete               @relation(fields: [athleteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  round                         Round                      @relation(fields: [roundId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recordingInspectorAssignment  MatchOfficialAssignment?   @relation("FaultRecordingInspectorAssignment", fields: [recordingInspectorAssignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recordingInspectorSession     MatchSession?              @relation("FaultRecordingInspectorSession", fields: [recordingInspectorSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([matchId, invalidatedAt], map: "faults_match_id_invalidated_at_idx")
  @@index([roundId, invalidatedAt], map: "faults_round_id_invalidated_at_idx")
  @@index([athleteId, invalidatedAt], map: "faults_athlete_id_invalidated_at_idx")
  @@map("faults")
}

model RoundAthleteResult {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId            String       @map("match_id") @db.Uuid
  roundId            String       @map("round_id") @db.Uuid
  athleteId          String       @map("athlete_id") @db.Uuid
  refereePoints      Int          @map("referee_points")
  faultCount         Int          @map("fault_count")
  capturedAt         DateTime     @default(now()) @map("captured_at") @db.Timestamptz(3)
  invalidatedAt      DateTime?    @map("invalidated_at") @db.Timestamptz(3)
  invalidatedByAuditId String?    @map("invalidated_by_audit_id") @db.Uuid
  match              Match        @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  round              Round        @relation(fields: [roundId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  athlete            MatchAthlete @relation(fields: [athleteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([roundId, athleteId], map: "round_athlete_results_round_id_athlete_id_key")
  @@index([matchId, invalidatedAt], map: "round_athlete_results_match_id_invalidated_at_idx")
  @@map("round_athlete_results")
}

model MatchAppeal {
  id                            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId                       String                    @map("match_id") @db.Uuid
  scope                         MatchAppealScope
  attemptNumber                 Int                       @default(0) @map("attempt_number") @db.SmallInt
  status                        MatchAppealStatus         @default(COMPLETED)
  sourceRoundId                 String                    @map("source_round_id") @db.Uuid
  completedInspectorAssignmentId String?                  @map("completed_inspector_assignment_id") @db.Uuid
  completedInspectorSessionId   String?                    @map("completed_inspector_session_id") @db.Uuid
  completedAt                   DateTime                   @default(now()) @map("completed_at") @db.Timestamptz(3)
  idempotencyKey                String?                    @map("idempotency_key") @db.VarChar(255)
  invalidatedAt                 DateTime?                  @map("invalidated_at") @db.Timestamptz(3)
  invalidatedByAuditId          String?                    @map("invalidated_by_audit_id") @db.Uuid
  match                         Match                      @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceRound                   Round                      @relation("MatchAppealSourceRound", fields: [sourceRoundId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  completedInspectorAssignment  MatchOfficialAssignment?   @relation("MatchAppealCompletedInspectorAssignment", fields: [completedInspectorAssignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  completedInspectorSession     MatchSession?              @relation("MatchAppealCompletedInspectorSession", fields: [completedInspectorSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  adjustments                   MatchAppealAdjustment[]
  sourceRounds                  MatchAppealRound[]
  outcome                       MatchOutcome?              @relation("MatchOutcomeSourceAppeal")

  @@index([matchId, scope, attemptNumber, invalidatedAt], map: "match_appeals_match_scope_attempt_invalidated_idx")
  @@index([idempotencyKey], map: "match_appeals_idempotency_key_key")
  @@map("match_appeals")
}

// A regulation appeal cites both completed regulation rounds. Overtime cites
// the one immutable attempt row; sourceRoundId remains the primary scope key.
model MatchAppealRound {
  appealId String      @map("appeal_id") @db.Uuid
  roundId  String      @map("round_id") @db.Uuid
  appeal   MatchAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  round    Round       @relation(fields: [roundId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([appealId, roundId])
  @@index([roundId], map: "match_appeal_rounds_round_id_idx")
  @@map("match_appeal_rounds")
}

model MatchAppealAdjustment {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appealId         String       @map("appeal_id") @db.Uuid
  athleteId        String       @map("athlete_id") @db.Uuid
  baseRefereeScore Int          @map("base_referee_score")
  bonusPoints      Int          @default(0) @map("bonus_points")
  penaltyPoints    Int          @default(0) @map("penalty_points")
  finalScore       Int          @map("final_score")
  appeal           MatchAppeal  @relation(fields: [appealId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  athlete          MatchAthlete @relation(fields: [athleteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([appealId, athleteId], map: "match_appeal_adjustments_appeal_id_athlete_id_key")
  @@map("match_appeal_adjustments")
}

model MatchOutcome {
  id                            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId                       String                    @unique(map: "match_outcomes_match_id_key") @map("match_id") @db.Uuid
  winnerAthleteId               String                    @map("winner_athlete_id") @db.Uuid
  winnerColor                   AthleteColor              @map("winner_color")
  method                        MatchOutcomeMethod
  sourceAppealId                String?                   @unique(map: "match_outcomes_source_appeal_id_key") @map("source_appeal_id") @db.Uuid
  sourceOvertimeRoundId         String?                   @map("source_overtime_round_id") @db.Uuid
  publishedInspectorAssignmentId String?                  @map("published_inspector_assignment_id") @db.Uuid
  publishedInspectorSessionId   String?                   @map("published_inspector_session_id") @db.Uuid
  publishedAt                   DateTime                  @default(now()) @map("published_at") @db.Timestamptz(3)
  snapshot                      Json                      @db.JsonB
  match                         Match                     @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  winnerAthlete                 MatchAthlete              @relation(fields: [winnerAthleteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceAppeal                  MatchAppeal?              @relation("MatchOutcomeSourceAppeal", fields: [sourceAppealId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceOvertimeRound           Round?                    @relation("MatchOutcomeSourceOvertimeRound", fields: [sourceOvertimeRoundId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  publishedInspectorAssignment  MatchOfficialAssignment?  @relation("MatchOutcomePublishedInspectorAssignment", fields: [publishedInspectorAssignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  publishedInspectorSession     MatchSession?             @relation("MatchOutcomePublishedInspectorSession", fields: [publishedInspectorSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("match_outcomes")
}

model AuditLog {
  id          String         @id(map: "audit_logs_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId     String?        @map("match_id") @db.Uuid
  // Compatibility name for existing scoring services; maps to the unified user FK.
  adminUserId String?        @map("user_id") @db.Uuid
  sessionId   String?        @map("session_id") @db.Uuid
  officialSessionId String?  @map("official_session_id") @db.Uuid
  eventType   AuditEventType @map("event_type")
  metadata    Json?          @db.JsonB
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  match       Match?         @relation(fields: [matchId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "audit_logs_match_id_fkey")
  user        User?          @relation(fields: [adminUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "audit_logs_user_id_fkey")
  session     MatchSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "audit_logs_session_id_fkey")
  officialSession TournamentOfficialSession? @relation(fields: [officialSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "audit_logs_official_session_id_fkey")

  @@index([matchId, createdAt], map: "audit_logs_match_id_created_at_idx")
  @@index([adminUserId], map: "audit_logs_user_id_idx")
  @@index([sessionId], map: "audit_logs_session_id_idx")
  @@index([officialSessionId], map: "audit_logs_official_session_id_idx")
  @@map("audit_logs")
}

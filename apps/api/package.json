{
  "name": "@martial-arts-scoring/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API for the martial arts scoring platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" \"prisma.config.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"prisma.config.ts\" \"*.json\" \"*.mjs\" \"*.cjs\"",
    "typecheck": "prisma generate && tsc --noEmit && pnpm run typecheck:tools",
    "typecheck:tools": "tsc --noEmit --strict --esModuleInterop --module commonjs --moduleResolution node --target ES2022 --types node --skipLibCheck prisma/seed.ts prisma/verify-initial-super-admin.ts prisma/report-legacy-admin-entitlements.ts prisma.config.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "lifecycle:run": "tsx src/subscriptions/run-lifecycle.ts",
    "media:reconcile": "tsx src/media/run-media-reconciliation.ts",
    "prisma:migrate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:migrate:status": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate status",
    "prisma:seed": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js db seed",
    "prisma:verify:super-admin": "tsx prisma/verify-initial-super-admin.ts",
    "prisma:report:legacy-admin-entitlements": "tsx prisma/report-legacy-admin-entitlements.ts",
    "prisma:verify:legacy-admin-entitlements": "powershell -ExecutionPolicy Bypass -File prisma/verify-legacy-admin-entitlements-migration.ps1",
    "prisma:verify:sport-catalog": "powershell -ExecutionPolicy Bypass -File prisma/verify-sport-catalog-migration.ps1",
    "prisma:studio": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@martial-arts-scoring/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.7.0",
    "multer": "^2.3.0",
    "nestjs-pino": "^4.4.1",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}

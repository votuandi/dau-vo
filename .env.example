# Local infrastructure
DATABASE_URL=postgresql://martial_arts:martial_arts@localhost:5432/martial_arts_scoring?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_DB=martial_arts_scoring
POSTGRES_USER=martial_arts
POSTGRES_PASSWORD=martial_arts
POSTGRES_PORT=5432
REDIS_PORT=6379

# API and browser origins
API_PORT=3000
# Relative to the API working directory. Compose mounts this location on a
# persistent volume; multiple API replicas require shared object storage.
IMAGE_UPLOAD_ROOT=public/uploads
# Comma-separated allowed browser origins; add this computer's LAN URL for device testing.
WEB_ORIGIN=http://localhost:5173,http://192.168.1.111:5173

# Socket.IO shares the API origin in development. Keeping the handshake below
# /api allows the HTTP-only match-session cookie to authenticate it.
VITE_SOCKET_PATH=/api/socket.io

# Development-only examples. Replace both with independent random secrets.
ADMIN_SESSION_SECRET=local-development-only-change-this-admin-session-secret
MATCH_SESSION_SECRET=local-development-only-change-this-match-session-secret
# Independent HMAC key for tournament-official passcode lookup digests.
OFFICIAL_PASSCODE_SECRET=local-development-only-change-this-official-passcode-secret
# Separate from the passcode lookup key and legacy match-session secret.
OFFICIAL_SESSION_SECRET=local-development-only-change-this-official-session-secret
OFFICIAL_SESSION_TTL_SECONDS=28800
OFFICIAL_ACCESS_RATE_LIMIT_IDENTITY_MAX_ATTEMPTS=10
OFFICIAL_ACCESS_RATE_LIMIT_IP_MAX_ATTEMPTS=100
OFFICIAL_ACCESS_RATE_LIMIT_WINDOW_SECONDS=60
# Independent HMAC key for short-lived, non-persisted bracket previews.
BRACKET_PREVIEW_SECRET=replace-with-an-independent-random-secret
MATCH_SESSION_TTL_SECONDS=28800

# Match participant login/takeover throttling is stored in Redis (window in seconds).
# The identity key combines match ID and security code; the IP key prevents
# distributed code guessing. Both are reset safely if Redis is reset.
MATCH_ACCESS_RATE_LIMIT_IDENTITY_MAX_ATTEMPTS=10
MATCH_ACCESS_RATE_LIMIT_IP_MAX_ATTEMPTS=100
MATCH_ACCESS_RATE_LIMIT_WINDOW_SECONDS=60

# Admin sessions and login throttling are stored in Redis (durations in seconds).
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Public match identifiers use a human-friendly cryptographic alphabet.
MATCH_PUBLIC_ID_INITIAL_LENGTH=6

# Initial system super-admin seed. These defaults are for local/staging use only.
# In production, INITIAL_SUPER_ADMIN_PASSWORD is mandatory and must not be dauvo@123.
INITIAL_SUPER_ADMIN_PASSWORD=dauvo@123

# Match timing is configured centrally in milliseconds.
ROUND_DURATION_MS=120000
BREAK_DURATION_MS=60000
